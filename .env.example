# .env로 복사 후 값 채우기. .env는 gitignore됨.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 업비트 조회 전용 키 (자산조회+입금조회+출금조회만 체크, IP 등록 필수) — 지갑 상태 수집용.
# 주문·출금 권한 키를 여기 넣지 말 것 (PLAN §4.1 키 3계층).
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 바이낸스 조회 전용 키 (Enable Reading만, IP 제한 등록) — 해외측 입출금 상태 수집 (V8).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 빗썸 조회 전용 키 (자산조회만, IP 등록) — 신 API 지갑 상태(신규상장 커버리지) + 네트워크 검증.
BITHUMB_API_KEY=
BITHUMB_API_SECRET=

# OKX 조회 전용 키 (Read만, IP 제한 등록; API 생성 시 정한 Passphrase 3요소) — M1 OKX 레그 게이트.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# 바이비트 조회 전용 키 (Read-Only, IP 제한 등록) — M1 바이비트 레그 게이트.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── 실거래 (M3, P3 직전에만 채움) ──────────────────────────────────────────
# 실주문 환경 잠금 — 1일 때만 주문 어댑터가 발사 가능 (§4.1 방어선 6). 평소엔 비워둘 것
LIVE_TRADING_ALLOWED=

# 거래(주문) 전용 키 — 조회 키와 별도 발급, **출금 권한 금지**, IP 제한 (§4.1 키 3계층)
OKX_TRADE_API_KEY=
OKX_TRADE_API_SECRET=
OKX_TRADE_API_PASSPHRASE=
UPBIT_TRADE_ACCESS_KEY=
UPBIT_TRADE_SECRET_KEY=
BITHUMB_TRADE_API_KEY=
BITHUMB_TRADE_API_SECRET=

# 출금 전용 키 (P3 개시 시점에 마지막으로 발급 — 출금 권한 有, IP 제한, 거래소 주소 화이트리스트 필수)
# 게이트웨이 Live 백엔드만 사용. 전략·주문 코드는 이 키를 읽지 않는다 (§4.1 방어선 3)
OKX_WITHDRAW_API_KEY=
OKX_WITHDRAW_API_SECRET=
OKX_WITHDRAW_API_PASSPHRASE=
UPBIT_WITHDRAW_ACCESS_KEY=
UPBIT_WITHDRAW_SECRET_KEY=
BITHUMB_WITHDRAW_API_KEY=
BITHUMB_WITHDRAW_API_SECRET=
